<?xml version="1.0" encoding="UTF-8"?>
<!--
  REPLACE: MyApp → your UIBundle DeveloperName
  REPLACE: masterLabel → human-readable name

  NOTE: <target>CustomApplication</target> is required and valid despite some docs saying otherwise.
  Without it, the UIBundle won't be linkable from a CustomApplication.
-->
<UIBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <masterLabel>My App</masterLabel>
    <description>A Salesforce UI Bundle.</description>
    <isActive>true</isActive>
    <version>1</version>
    <target>CustomApplication</target>
</UIBundle>
