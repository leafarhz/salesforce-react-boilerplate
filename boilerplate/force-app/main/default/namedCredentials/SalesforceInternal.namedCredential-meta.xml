<?xml version="1.0" encoding="UTF-8"?>
<!--
  REPLACE: endpoint URL with your org's My Domain URL
  Sandbox:  https://<myDomain>--<sandboxName>.sandbox.my.salesforce.com
  Scratch:  https://<scratchDomain>.scratch.my.salesforce.com
  Prod:     https://<myDomain>.my.salesforce.com

  Required fields for v67.0: <endpoint> and <principalType>
  Do NOT include a <name> element — the API name comes from the filename.
-->
<NamedCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>SalesforceInternal</label>
    <endpoint>https://YOUR-MYDOMAIN.sandbox.my.salesforce.com</endpoint>
    <principalType>Anonymous</principalType>
    <protocol>NoAuthentication</protocol>
    <allowMergeFieldsInBody>false</allowMergeFieldsInBody>
    <allowMergeFieldsInHeader>false</allowMergeFieldsInHeader>
    <generateAuthorizationHeader>false</generateAuthorizationHeader>
</NamedCredential>
