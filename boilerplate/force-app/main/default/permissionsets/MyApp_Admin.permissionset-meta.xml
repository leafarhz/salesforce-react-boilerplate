<?xml version="1.0" encoding="UTF-8"?>
<!--
  REPLACE: MyApp → your app/object names throughout

  CHECKLIST before deploying:
  1. Add applicationVisibilities for your app
  2. Add objectPermissions for every custom object the app queries
  3. Add fieldPermissions for every non-required custom field
     - Do NOT add required fields (Salesforce rejects the deploy)
     - Check required fields: grep "<required>true</required>" force-app/main/default/objects/<Obj>/fields/*.field-meta.xml
  4. Add classAccesses for every Apex class called by the app
-->
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>My App Admin</label>
    <description>Full access to My App.</description>
    <hasActivationRequired>false</hasActivationRequired>

    <!-- 1. App visibility — required to see the app in App Launcher -->
    <applicationVisibilities>
        <application>MyApp</application>
        <visible>true</visible>
    </applicationVisibilities>

    <!-- 2. Apex class access -->
    <classAccesses>
        <apexClass>MyAppController</apexClass>
        <enabled>true</enabled>
    </classAccesses>

    <!-- 3. Object permissions -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>MyCustomObject__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- 4. Field-level security — every non-required custom field needs this -->
    <!--    Object-level READ does NOT automatically grant field access -->
    <fieldPermissions>
        <editable>true</editable>
        <field>MyCustomObject__c.MyField__c</field>
        <readable>true</readable>
    </fieldPermissions>

</PermissionSet>
