<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>My App</masterLabel>
    <description>Embeds the MyApp UIBundle (React) on a record page with lightning-ui-embedding.</description>
    <targets>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <property name="appUrl" type="String" label="App URL (optional)" description="Override the computed https://...salesforce.app/app/c__MyApp address." />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
